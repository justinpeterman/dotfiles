README.md
bootstrap.sh
.git
.gitignore
.idea

# TPM clones tmux plugins inside a chezmoi-managed directory; leave them alone.
.config/tmux/plugins/**

# Brewfiles are read from the chezmoi source dir by run_onchange_brew-bundle,
# so they must never be applied into $HOME.
Brewfile
Brewfile.personal
Brewfile.server

{{ if ne .machine_type "server" -}}
macos-defaults-server.sh
tailscale-daemon-server.sh
cloudflared-server.sh
# Homebrew PATH for non-interactive CI SSH shells is server-only; personal
# machines get their PATH from .zprofile/.zshrc.
.zshenv
{{ end -}}
{{ if ne .machine_type "personal" -}}
# Tailscale GUI CLI shim only applies to personal machines; servers run the
# tailscaled daemon instead (tailscale-daemon-server.sh).
tailscale-cli.sh
{{ end -}}
{{ if not (stat "/Applications/iTerm.app") -}}
# iTerm2 font profile applies wherever iTerm is installed — including the mini
# (machine_type=server but used interactively with a display) — and is skipped
# on genuinely headless boxes with no iTerm. Gated on presence, not machine_type.
Library/Application Support/iTerm2/DynamicProfiles/dotfiles.json
iterm-font.sh
{{ end -}}
