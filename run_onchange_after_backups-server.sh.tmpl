#!/usr/bin/env bash

# SERVER-only (gated off personal machines in .chezmoiignore). Installs a simple
# LOCAL daily backup for every app in the .chezmoidata.yaml `apps` list (Phase 7 /
# Step 17, and a concrete Phase 5 LaunchAgent example). Deliberately minimal for
# hobby projects: a consistent SQLite copy + shared/.env + shared/uploads into
# ~/backups/<app>/<timestamp>/, keeping the last 7. NO encryption and NO off-site
# copy — if these apps ever hold data worth protecting properly, add those then.
#
# Generates ~/apps/backup-apps.sh (loops the apps list) + a launchd agent that runs
# it daily at 03:00, and runs one backup now to verify. run_onchange: re-runs when
# the apps list changes. Non-interactive (no sudo).

set -euo pipefail

BACKUP_SCRIPT="$HOME/apps/backup-apps.sh"
PLIST="$HOME/Library/LaunchAgents/local.app-backups.plist"
UID_NUM="$(id -u)"
mkdir -p "$HOME/apps" "$HOME/Library/LaunchAgents" "$HOME/logs" "$HOME/backups"

# ── generate the backup script (baked with each app's dir from the list) ──────
rm -f "$BACKUP_SCRIPT"
cat > "$BACKUP_SCRIPT" <<'BK_EOF'
#!/bin/bash
# GENERATED by run_onchange_after_backups-server.sh.tmpl — edit the generator, not
# this. Local-only per-app backup: consistent SQLite copy + env + uploads, last 7 kept.
set -euo pipefail
KEEP=7
TS="$(date +%Y%m%d-%H%M%S)"

backup_app() {
  name="$1"; appdir="$2"; shared="$appdir/shared"; dest="$HOME/backups/$name/$TS"
  if [ ! -d "$shared" ]; then echo "  · $name: no shared/ yet, skipping"; return 0; fi
  mkdir -p "$dest"
  # SQLite DBs: online .backup is consistent against a live WAL db (never cp one),
  # then confirm the copy is actually restorable.
  shopt -s nullglob
  for db in "$shared"/data/*.db; do
    base="$(basename "$db")"
    sqlite3 "$db" ".backup '$dest/$base'"
    if [ "$(sqlite3 "$dest/$base" 'PRAGMA integrity_check;')" != "ok" ]; then
      echo "  ✗ $name: integrity check FAILED for $base" >&2; return 1
    fi
  done
  # env + uploads are regular files — a plain copy is fine.
  [ -f "$shared/.env" ] && cp "$shared/.env" "$dest/"
  [ -d "$shared/uploads" ] && cp -R "$shared/uploads" "$dest/"
  # rotate: keep the newest $KEEP timestamped dirs
  ls -1dt "$HOME/backups/$name"/*/ 2>/dev/null | tail -n "+$((KEEP + 1))" | xargs rm -rf 2>/dev/null || true
  echo "  ✓ $name -> $dest"
}

echo "→ Backing up apps ($(date))..."
BK_EOF
# append one backup_app call per app (chezmoi injects each app's name + home path)
cat >> "$BACKUP_SCRIPT" <<CALLS_EOF
{{- range .apps }}
backup_app "{{ .name }}" "{{ $.chezmoi.homeDir }}/apps/{{ .name }}"
{{- end }}
echo "✓ Backups complete."
CALLS_EOF
chmod 700 "$BACKUP_SCRIPT"

# ── launchd agent: run the backup daily at 03:00 ─────────────────────────────
rm -f "$PLIST"
cat > "$PLIST" <<PL_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>local.app-backups</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>exec "$BACKUP_SCRIPT"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/usr/bin:/bin</string></dict>
    <key>StandardOutPath</key><string>$HOME/logs/backups.log</string>
    <key>StandardErrorPath</key><string>$HOME/logs/backups.log</string>
  </dict>
</plist>
PL_EOF

launchctl bootout "gui/$UID_NUM/local.app-backups" 2>/dev/null || true
launchctl bootstrap "gui/$UID_NUM" "$PLIST" 2>/dev/null \
  || launchctl load -w "$PLIST" 2>/dev/null || true

# ── verify: syntax, then run one backup now ──────────────────────────────────
bash -n "$BACKUP_SCRIPT" || { echo "✗ generated backup script has a syntax error" >&2; exit 1; }
echo "→ Running an initial backup to verify..."
"$BACKUP_SCRIPT"
echo "✓ Backup automation installed (daily 03:00, last $((7)) kept in ~/backups)."
