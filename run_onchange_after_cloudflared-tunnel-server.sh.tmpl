#!/usr/bin/env bash

# SERVER-only (gated off personal machines in .chezmoiignore). Regenerates the
# Cloudflare Tunnel ingress config + per-app DNS routes from the `apps` list in
# .chezmoidata.yaml (Phase 2 of the mac-mini guide). The tunnel itself — `cloudflared
# tunnel login` / `create`, and running it at boot — is ONE-TIME manual setup; this
# script owns only the parts that change as you add or remove apps.
#
# run_onchange: reruns whenever the apps list or tunnel name changes. Idempotent and
# non-interactive — writes ~/.cloudflared/config.yml (user-owned) and calls
# `cloudflared tunnel route dns` per app (safe to repeat). If the one-time tunnel
# setup isn't done yet it skips with instructions, so it's harmless to ship early.
#
# Run modes: if the tunnel runs as a *user* `cloudflared tunnel run`, ~/.cloudflared/
# config.yml IS the live config. If it runs as the *system daemon* (installed with
# `sudo cloudflared service install`, reads /etc/cloudflared), ~/.cloudflared/config.yml
# is the reviewable SOURCE and the daemon is updated by the sudo sync command this
# script prints — writing /etc and restarting the daemon needs sudo, so we don't do
# it unattended. Either way, generating the config here never disrupts a live daemon.

set -euo pipefail

# node@22 (keg-only) parses the tunnel-list JSON; /opt/homebrew/bin has cloudflared.
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
[[ -d /opt/homebrew/opt/node@22/bin ]] && export PATH="/opt/homebrew/opt/node@22/bin:$PATH"

TUNNEL='{{ .cloudflare_tunnel }}'
CONFIG="$HOME/.cloudflared/config.yml"

if ! command -v cloudflared >/dev/null 2>&1; then
  echo "⚠ cloudflared not found (expected from Brewfile.server). Skipping tunnel config."
  exit 0
fi

# Resolve the tunnel's UUID by name from the authenticated cloudflared state.
TUNNEL_ID="$(cloudflared tunnel list --output json 2>/dev/null | node -e '
  let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{
    const t=JSON.parse(d).find(x=>x.name===process.argv[1]);
    process.stdout.write(t&&t.id?t.id:"");
  }catch(e){}});' "$TUNNEL")"

if [[ -z "$TUNNEL_ID" ]]; then
  echo "⚠ Cloudflare tunnel '$TUNNEL' not found. Do the one-time setup first (Phase 2):"
  echo "    cloudflared tunnel login"
  echo "    cloudflared tunnel create $TUNNEL"
  echo "  then re-apply. Skipping for now."
  exit 0
fi

CREDS="$HOME/.cloudflared/$TUNNEL_ID.json"
if [[ ! -f "$CREDS" ]]; then
  echo "⚠ Tunnel '$TUNNEL' ($TUNNEL_ID) has no local credentials at $CREDS."
  echo "  Re-create it on this machine: cloudflared tunnel create $TUNNEL. Skipping."
  exit 0
fi

echo "→ Writing $CONFIG for tunnel '$TUNNEL' ($TUNNEL_ID)..."
mkdir -p "$HOME/.cloudflared"
cat > "$CONFIG" <<EOF
# GENERATED by run_onchange_after_cloudflared-tunnel-server.sh.tmpl — edit the apps
# list in .chezmoidata.yaml, not this file. Each app is routed hostname -> its local
# PM2 port; everything else 404s. The portfolio (justinpeterman.com / www) is NOT
# here — it stays on GitHub Pages.
tunnel: $TUNNEL_ID
credentials-file: $CREDS

ingress:
{{- range .apps }}
  - hostname: {{ .hostname }}
    service: http://localhost:{{ .port }}
{{- end }}
  - service: http_status:404
EOF

echo "→ Ensuring DNS routes..."
route_failed=0
{{- range .apps }}
if out="$(cloudflared tunnel route dns "$TUNNEL" "{{ .hostname }}" 2>&1)"; then
  echo "  ✓ {{ .hostname }}"
elif grep -qiE 'already (exists|configured)' <<<"$out"; then
  echo "  ✓ {{ .hostname }} (already routed)"
else
  echo "  ✗ {{ .hostname }}: $out"; route_failed=1
fi
{{- end }}

echo "→ Validating ingress config..."
cloudflared --config "$CONFIG" tunnel ingress validate \
  || { echo "✗ config.yml failed ingress validation." >&2; exit 1; }

# If a system daemon is in use (it reads /etc/cloudflared, not ~/.cloudflared), the
# generated config has to be copied there and the daemon restarted — that needs sudo,
# so we print the command rather than run it unattended.
if [[ -f /Library/LaunchDaemons/com.cloudflare.cloudflared.plist ]]; then
  echo "ℹ A system cloudflared daemon is installed (reads /etc/cloudflared, not ~). It"
  echo "  keeps serving the OLD config until you sync this one and restart it (needs sudo;"
  echo "  the root daemon can read the home credentials-file referenced inside):"
  echo "    sudo mkdir -p /etc/cloudflared && sudo cp \"$CONFIG\" /etc/cloudflared/config.yml && sudo launchctl kickstart -k system/com.cloudflare.cloudflared"
fi

if [[ "$route_failed" -ne 0 ]]; then
  echo "⚠ One or more DNS routes failed (see ✗ above); config.yml was still written." >&2
  exit 1
fi
echo "✓ Tunnel ingress + DNS routes in sync with the apps list."
