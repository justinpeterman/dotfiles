#!/usr/bin/env bash
# chezmoi re-runs this whenever Brewfile or the active Brewfile.{{ .machine_type }} changes.
# hash-shared: {{ include "Brewfile" | sha256sum }}
# hash-machine: {{ if eq .machine_type "personal" }}{{ include "Brewfile.personal" | sha256sum }}{{ else if eq .machine_type "server" }}{{ include "Brewfile.server" | sha256sum }}{{ end }}
set -euo pipefail

echo "→ Running brew bundle..."
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile" || echo "⚠ brew bundle reported failures for the shared Brewfile (continuing)"
{{ if eq .machine_type "personal" -}}
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.personal" || echo "⚠ brew bundle reported failures for Brewfile.personal (continuing)"
{{ else if eq .machine_type "server" -}}
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.server" || echo "⚠ brew bundle reported failures for Brewfile.server (continuing)"
{{ end -}}
echo "✓ brew bundle complete"
