# ── CLI tools ───────────────────────────────
brew "yt-dlp"
brew "cocoapods"

# ── Apps ─────────────────────────────────────────────────────
cask "1password"
cask "firefox"
cask "spotify"
cask "webstorm"
cask "zoom"
# Standalone Tailscale GUI (menu bar), non-sandboxed. Used as a client to reach
# the server over the tailnet (SSH / screen sharing); it does not run an SSH
# server of its own. Servers use the tailscaled formula instead (Brewfile.server).
# Never install the App Store build — it's fully sandboxed (no CLI, subnet
# routing, or exit nodes).
cask "tailscale-app"

# ── Mac App Store ────────────────────────────────────────────
brew "mas"
# Requires being signed into the Mac App Store first; brew bundle tolerates failure (see run_onchange_brew-bundle).
mas "Xcode", id: 497799835
