# ── CLI tools ───────────────────────────────
# fnm — Node version manager (per-project switching via .node-version / --use-on-cd),
# wired up interactively in dot_zshrc. Personal-only: servers use a pinned brew node@22
# for their non-interactive deploy runtime instead (see Brewfile.server / dot_zshenv).
brew "fnm"
brew "yt-dlp"
brew "cocoapods"

# ── Apps ─────────────────────────────────────────────────────
cask "1password"
cask "codex"
cask "firefox"
cask "spotify"
cask "webstorm"
cask "zoom"
# Standalone Tailscale GUI (menu bar). Non-sandboxed, so it *can* run the SSH
# server — but only within a logged-in GUI session. Servers use the tailscaled
# formula instead (Brewfile.server). Never install the App Store build — it's
# fully sandboxed and cannot run Tailscale SSH.
cask "tailscale-app"

# ── Mac App Store ────────────────────────────────────────────
brew "mas"
# Requires being signed into the Mac App Store first; brew bundle tolerates failure (see run_onchange_brew-bundle).
mas "Xcode", id: 497799835
