{{- /* SERVER-only: make Homebrew tools visible to non-interactive CI SSH. */ -}}
# ~/.zshenv is sourced by `ssh host command`, unlike .zprofile/.zshrc.
# Application runtimes are resolved explicitly through `mise exec`.
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
[[ -d /usr/local/bin ]] && export PATH="/usr/local/bin:$PATH"
