#!/usr/bin/env bash

# SERVER-only (gated off personal machines in .chezmoiignore). Scaffolds the on-disk
# layout every PM2-deployed app needs (Phase 4 Steps 2-4 of the mac-mini guide),
# driven by the `apps` list in .chezmoidata.yaml. Adding an app there re-renders this
# script; run_onchange then reruns it because the rendered content changed.
#
# Per app it creates ~/apps/<name>/{releases,shared/{uploads,data}}, a placeholder
# shared/.env (600, created once and NEVER clobbered so real secrets survive), and
# generates activate-release.sh + ecosystem.config.js from the app's values. It does
# NOT start anything or touch PM2 — the first CI deploy does that. Idempotent and
# non-interactive (no sudo).
#
# Everything is generated from the list, so these files are not hand-edited on the
# server; edit this generator (or the apps list) and re-apply.

set -euo pipefail

# node@22 is keg-only; put it (and the pm2 shim dir) on PATH for the `node -e` verify.
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
[[ -d /opt/homebrew/opt/node@22/bin ]] && export PATH="/opt/homebrew/opt/node@22/bin:$PATH"

mkdir -p "$HOME/logs"   # shared log dir for cron/LaunchAgent jobs (Phase 5)

{{ range .apps }}
# ─────────────────────────────────────────────────────────────
# app: {{ .name }}  (port {{ .port }})
# ─────────────────────────────────────────────────────────────
NAME='{{ .name }}'
APP_DIR="$HOME/apps/{{ .name }}"
SHARED="$APP_DIR/shared"
echo "→ Scaffolding '$NAME' at $APP_DIR (port {{ .port }})..."

mkdir -p "$APP_DIR/releases" "$SHARED/uploads" "$SHARED/data"

# shared/.env — create once with placeholders; never overwrite real secrets.
if [[ ! -f "$SHARED/.env" ]]; then
  cat > "$SHARED/.env" <<'ENV_EOF'
# Production env for {{ .name }}. Fill in real values — this file lives outside the
# release dirs and is symlinked into each deploy, so it persists across releases.
NODE_ENV=production
PORT={{ .port }}
ENV_EOF
  echo "  · created $SHARED/.env (placeholder — add real secrets over SSH)"
fi
chmod 600 "$SHARED/.env"

# activate-release.sh — run over SSH by the deploy workflow to finish a release:
# prod install in the new dir, swap the current symlink, reload PM2, health-check,
# roll back on failure. Quoted heredoc: chezmoi injects {{`{{ ... }}`}} values; bash
# leaves $RELEASE/$1/etc. as the generated script's own runtime variables.
cat > "$APP_DIR/activate-release.sh" <<'ACT_EOF'
#!/bin/bash
# GENERATED by run_onchange_after_server-apps.sh.tmpl — edit the generator, not this.
set -euo pipefail
APP_ROOT="{{ $.chezmoi.homeDir }}/apps/{{ .name }}"
RELEASE="$APP_ROOT/releases/$1"
SHARED="$APP_ROOT/shared"
HEALTH_URL="http://localhost:{{ .port }}/healthz"

# Link persistent state into the release (kept out of the rsynced checkout)
ln -sfn "$SHARED/.env"    "$RELEASE/.env"
ln -sfn "$SHARED/uploads" "$RELEASE/uploads"
ln -sfn "$SHARED/data"    "$RELEASE/data"

# Platform-correct prod install in the NEW dir (live app untouched if it fails)
cd "$RELEASE"
npm ci --omit=dev

# Remember the rollback target, swap the symlink, reload
PREVIOUS="$(readlink "$APP_ROOT/current" 2>/dev/null || true)"
ln -sfn "$RELEASE" "$APP_ROOT/current"
pm2 startOrReload "$APP_ROOT/ecosystem.config.js" --update-env

# Health gate — roll back and fail the deploy if the new release doesn't answer
if ! curl -fsS --retry 5 --retry-delay 2 --max-time 5 "$HEALTH_URL" >/dev/null; then
  echo "Health check failed."
  if [[ -n "$PREVIOUS" ]]; then
    echo "Rolling back to $PREVIOUS"
    ln -sfn "$PREVIOUS" "$APP_ROOT/current"
    pm2 startOrReload "$APP_ROOT/ecosystem.config.js" --update-env
  fi
  exit 1
fi

# Keep only the 5 most recent releases
ls -1dt "$APP_ROOT"/releases/*/ | tail -n +6 | xargs rm -rf 2>/dev/null || true
echo "Deployed $1"
ACT_EOF
chmod 700 "$APP_DIR/activate-release.sh"

# ecosystem.config.js — single fork-mode process (SQLite is single-writer), cwd on
# the current symlink so each reload picks up the freshly swapped release.
cat > "$APP_DIR/ecosystem.config.js" <<'ECO_EOF'
// GENERATED by run_onchange_after_server-apps.sh.tmpl — edit the generator, not this.
const APP_ROOT = "{{ $.chezmoi.homeDir }}/apps/{{ .name }}";
module.exports = {
  apps: [{
    name: "{{ .name }}",
    cwd: `${APP_ROOT}/current`,
    script: "{{ .entrypoint }}",
    instances: 1,
    exec_mode: "fork",
    env: { NODE_ENV: "production" }
  }]
};
ECO_EOF

# verify — syntax, requireability, env perms
bash -n "$APP_DIR/activate-release.sh" || { echo "✗ $NAME: activate-release.sh has a syntax error" >&2; exit 1; }
node -e "require('$APP_DIR/ecosystem.config.js')" >/dev/null || { echo "✗ $NAME: ecosystem.config.js is not valid" >&2; exit 1; }
[[ "$(stat -f '%Sp' "$SHARED/.env")" == "-rw-------" ]] || { echo "✗ $NAME: shared/.env is not chmod 600" >&2; exit 1; }
echo "  ✓ $NAME scaffolded and verified"
{{ end }}
echo "✓ All apps scaffolded."
