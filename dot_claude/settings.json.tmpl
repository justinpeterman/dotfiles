{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": {{ if eq .machine_type "server" }}false{{ else }}true{{ end }},
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/python3 {{ .chezmoi.homeDir }}/.claude/statusline.py",
    "padding": 0
  }
}
