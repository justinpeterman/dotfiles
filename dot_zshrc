# ── Homebrew ─────────────────────────────────────────────────
if [[ -d /opt/homebrew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  BREW_PREFIX=/opt/homebrew
else
  BREW_PREFIX=/usr/local
fi

# ── History ──────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# ── Editor ───────────────────────────────────────────────────
export EDITOR="nano"

# ── pyenv ────────────────────────────────────────────────────
# PATH handled in .zprofile; this sets up shell integration
command -v pyenv >/dev/null && eval "$(pyenv init -)"

# ── mise (project runtimes) ──────────────────────────────────
command -v mise >/dev/null && eval "$(mise activate zsh)"

# ── claude-auto-retry wrapper ────────────────────────────────
# run_onchange_after_claude-auto-retry.sh renders the claude() wrapper into this
# unmanaged file (not into this dot_zshrc), specifically so `chezmoi apply`
# regenerating dot_zshrc from source can never erase it. Sourced after mise
# activate above, since the wrapper's `node "<launcher>"` call needs mise's
# node shim already on PATH.
[[ -r "$HOME/.config/claude-auto-retry/wrapper.zsh" ]] && source "$HOME/.config/claude-auto-retry/wrapper.zsh"

# ── direnv ───────────────────────────────────────────────────
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# ── Prompt ───────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"

# ── Navigation ───────────────────────────────────────────────
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ── Plugins ──────────────────────────────────────────────────
[[ -r "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ── jenv (Java) ──────────────────────────────────────────────
[[ -d "$HOME/.jenv/bin" ]] && export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv >/dev/null && eval "$(jenv init -)"

# ── Aliases ──────────────────────────────────────────────────
alias cat="bat"
alias ls="eza --icons"
alias ll="eza -la --icons --git"
alias la="eza -la --icons --all"
# zoxide: use `z <dir>` for smart navigation
