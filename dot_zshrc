# ── Homebrew ─────────────────────────────────────────────────
if [[ -d /opt/homebrew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  BREW_PREFIX=/opt/homebrew
else
  BREW_PREFIX=/usr/local
fi

# ── History ──────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# ── Editor ───────────────────────────────────────────────────
export EDITOR="nano"

# ── pyenv ────────────────────────────────────────────────────
# PATH handled in .zprofile; this sets up shell integration
command -v pyenv >/dev/null && eval "$(pyenv init -)"

# ── fnm (Node) ───────────────────────────────────────────────
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

# ── direnv ───────────────────────────────────────────────────
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# ── Prompt ───────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"

# ── Navigation ───────────────────────────────────────────────
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ── Plugins ──────────────────────────────────────────────────
[[ -r "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ── jenv (Java) ──────────────────────────────────────────────
[[ -d "$HOME/.jenv/bin" ]] && export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv >/dev/null && eval "$(jenv init -)"

# ── Aliases ──────────────────────────────────────────────────
alias cat="bat"
alias ls="eza --icons"
alias ll="eza -la --icons --git"
alias la="eza -la --icons --all"
# zoxide: use `z <dir>` for smart navigation
